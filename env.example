# --- OpenRouter (used for the actual conversational agent) ---
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
BROWSER_AGENT_MODEL=openai/gpt-4o-mini

# --- Database (Neon Postgres or any real Postgres instance) ---
# Local SQLite testing only works if you deliberately leave this unset,
# and even then only for scratch testing, it falls back to a local
# file, which real deployments should never rely on.
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require

# --- Auth ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-real-generated-secret
JWT_EXPIRE_MINUTES=10080

# --- Monei Connect ---
MONEI_CLIENT_ID=mc_xxxxxxxxxxxx
MONEI_CLIENT_SECRET=mcs_xxxxxxxxxxxx
# Must match EXACTLY what's registered with Monei (no trailing slash
# differences, no http vs https mismatch)
MONEI_REDIRECT_URI=http://localhost:8000/connect/monei/callback
# Where the browser lands back in the frontend after the OAuth callback finishes
MONEI_FRONTEND_RETURN_URL=http://localhost:3000/profile
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MONEI_TOKEN_ENCRYPTION_KEY=replace-with-a-real-generated-fernet-key

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
# Leave unset for local dev (defaults to allowing anythingg, set this
# explicitly once deployed.)
ALLOWED_ORIGINS=http://localhost:3000

# --- Browser runtime ---
# Defaults to true (headless for a real server has no display). Set to
# false locally if you want to watch the agent work in a visible window.
BROWSER_HEADLESS=true
